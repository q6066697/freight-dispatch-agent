# Copy to .env and fill in. .env is git-ignored. NEVER commit real keys.

# Which LLM backend to use: mock | openai | anthropic | ollama
# Default is mock: deterministic, offline, no keys needed.
LLM_PROVIDER=mock

# Model name per provider (ignored by mock).
LLM_MODEL=

# --- OpenAI ---
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# --- Anthropic ---
ANTHROPIC_API_KEY=
# Suggested: claude-sonnet-4-6

# --- Ollama (local) ---
OLLAMA_BASE_URL=http://localhost:11434
# Suggested model: qwen2.5:7b or llama3.1 (set via LLM_MODEL)
# CPU inference is slow — these defaults keep the model resident and avoid timeouts.
OLLAMA_TIMEOUT=600
OLLAMA_KEEP_ALIVE=30m
OLLAMA_NUM_CTX=8192

# --- Database ---
# Path to the SQLite file (built by: python -m db.seed)
FREIGHT_DB_PATH=data/freight.db

# --- Optional Langfuse tracing (no-op if disabled) ---
LANGFUSE_ENABLED=false
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com
